{
  "name": "atenea-policial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "dev:turbo": "next dev",
    "schema": "node scripts/schema-snapshot.mjs",
    "schema:migration": "node scripts/dump-migration.mjs",
    "smoke": "node scripts/smoke-contratos.mjs",
    "chat:probar": "node --experimental-strip-types scripts/probar-chat.mjs",
    "temario:anexo": "NODE_USE_ENV_PROXY=1 node scripts/temario/extraer-anexo.mjs",
    "temario:descargar": "NODE_USE_ENV_PROXY=1 node scripts/temario/descargar-boe.mjs",
    "temario:componer": "node scripts/temario/componer-tema.mjs",
    "temario:pdf": "node scripts/temario/generar-pdf.mjs",
    "temario:comprobar": "node --experimental-strip-types scripts/temario/comprobar-tema.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.95.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.4",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "openai": "^6.18.0",
    "pdf2json": "^4.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pdfkit": "^0.20.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
