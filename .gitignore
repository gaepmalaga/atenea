# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
firebase-debug.log

# claude code: la configuracion del servidor de desarrollo SI se comparte
# (.claude/launch.json); los ajustes y permisos de cada maquina, no.
.claude/settings.local.json

# Cache de normas descargadas del BOE. Se regenera con `npm run temario:descargar`;
# lo que se versiona es el temario compuesto (temario/md y temario/pdf).
temario/fuentes/BOE-*.json

# Banco de pruebas de la interfaz: bundle generado, CSS compilado y capturas.
# Los guiones que lo levantan SI se versionan (ver docs/BANCO-DE-PRUEBAS.md).
.banco-pruebas/app.js
.banco-pruebas/estilos.css
.banco-pruebas/entrada.css
.banco-pruebas/tomas/
# Las maquetas SE GENERAN (`maquetas/tomar.cjs`). Lo que se guarda es el guion
# que las dibuja, no los PNG: una imagen en el repositorio envejece sin que
# nadie lo note y acaba enseñando algo que ya no es la pantalla.
.banco-pruebas/maquetas/*.png
