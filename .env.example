# =====================================================================
# ATENEA POLICIAL - Variables de entorno
# Copia este fichero a `.env.local` y rellena los valores reales.
# `.env*` está en .gitignore: NUNCA subas las claves al repositorio.
# =====================================================================

# --- Supabase ---
# URL del proyecto y clave pública (van al navegador, son seguras de exponer).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CLAVE DE SERVICIO: salta TODAS las políticas RLS.
# Solo servidor. Si se filtra, se filtra la base de datos entera.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini ---
# Usada por el chat RAG, el generador de preguntas, las flashcards,
# la entrevista y el plan físico. Solo servidor.
GEMINI_API_KEY=

# --- Correo de la app (P12) ---
# Los avisos de solicitud de alta y su resolución los manda la PROPIA app
# (no Supabase Auth, que solo manda SUS correos: confirmar cuenta, invitación,
# recuperar clave). Resend, sobre el dominio propio ateneapolicial.com
# (comprado en Cloudflare, verificado en Resend). Empezó con Gmail por SMTP
# directo, pero Google bloqueó esa cuenta por sospecha de bot.
RESEND_API_KEY=

# URL pública de la app, para los enlaces de los correos. Por defecto usa la
# de producción si no se pone (`app/lib/registration-requests.ts`).
NEXT_PUBLIC_SITE_URL=
